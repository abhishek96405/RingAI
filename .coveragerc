[run]
source = backend
branch = True
omit =
    backend/tests/*
    backend/temp_*.py
    backend/debug_*.py
    backend/seed_*.py
    backend/runtime.txt

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
show_missing = True
skip_covered = False
precision = 1

[html]
directory = test_reports/coverage_html

[xml]
output = test_reports/coverage.xml
